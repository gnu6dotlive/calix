# Maintainer: tension-atoi <tension-atoi@users.noreply.github.com>
# Forked from: Seafoam-Labs/Shelly-ALPM
# Paquet: frontend GPUI natif Rust pour Calix — gestionnaire de paquets Arch Linux
#          (ALPM, AUR, Flatpak, AppImage, Cargo, NPM, releases GitHub/GitLab)
#
# Le backend CLI Zig reste installé sous /usr/lib/shelly/shelly tant que la
# migration du backend (Shelly.Cli.Zig → calix.cli.zig) n'est pas terminée ;
# le frontend Calix l'atteint via la variable SHELLY_BIN.

pkgname=calix-gpui-git
pkgver=r0.git
pkgrel=1
pkgdesc="Frontend GPUI natif Rust pour Calix — gestionnaire de paquets Arch Linux (ALPM, AUR, Flatpak, AppImage)"
arch=('x86_64')
url="https://github.com/tension-atoi/calix"
license=('GPL-3.0-only')
depends=(
    'glibc'
    'gcc-libs'
    'fontconfig'
    'freetype2'
    'libx11'
    'libxcb'
    'libxkbcommon'
    'libxkbcommon-x11'
    'wayland'
    'libglvnd'
    'mesa'
    'vulkan-icd-loader'
    'pacman'
    'polkit'
)
makedepends=(
    'git'
    'rust'
    'cargo'
    'zig'
    'pkgconf'
    'clang'
)
optdepends=(
    'flatpak: support des applications Flatpak'
    'paru: support AUR via Shelly'
    'yay: support AUR alternatif'
)
provides=('calix-gpui')
conflicts=('calix-gpui' 'shelly-gpui')
source=("${pkgname}::git+https://github.com/tension-atoi/calix.git#branch=main")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${pkgname}"
    printf "r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "${srcdir}/${pkgname}/Shelly.Ui.Gpui"
    cargo fetch --locked
}

build() {
    cd "${srcdir}/${pkgname}"

    # 1. Compile the Zig CLI backend (still shipped as `shelly` for now)
    echo ">>> Compiling the Zig CLI backend..."
    cd Shelly.Cli.Zig
    zig build -Doptimize=ReleaseSafe
    cd ..

    # 2. Compile the Calix GPUI frontend (Rust)
    echo ">>> Compiling the Calix GPUI frontend (Rust)..."
    cd Shelly.Ui.Gpui
    export CARGO_TARGET_DIR="target"
    SHELLY_BIN="${srcdir}/${pkgname}/Shelly.Cli.Zig/zig-out/bin/shelly" \
        cargo build --release --locked
}

check() {
    cd "${srcdir}/${pkgname}/Shelly.Ui.Gpui"
    export CARGO_TARGET_DIR="target"
    SHELLY_BIN="${srcdir}/${pkgname}/Shelly.Cli.Zig/zig-out/bin/shelly" \
        cargo test --release --locked
}

package() {
    cd "${srcdir}/${pkgname}"

    # ── Binaries ─────────────────────────────────────────────────────────────
    install -Dm755 "Shelly.Cli.Zig/zig-out/bin/shelly" \
        "${pkgdir}/usr/lib/shelly/shelly"

    install -Dm755 "Shelly.Ui.Gpui/target/release/calix-gpui" \
        "${pkgdir}/usr/lib/calix/calix-gpui"

    # Wrapper /usr/bin/calix-gpui setting SHELLY_BIN and executing the binary
    install -dm755 "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/calix-gpui" << 'EOF'
#!/bin/sh
SHELLY_BIN=/usr/lib/shelly/shelly exec /usr/lib/calix/calix-gpui "$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/calix-gpui"

    # ── Desktop Entry ────────────────────────────────────────────────────────
    install -Dm644 "Shelly.Ui.Gpui/assets/com.calix.calix-gpui.desktop" \
        "${pkgdir}/usr/share/applications/com.calix.calix-gpui.desktop"

    # ── SVG Icon ─────────────────────────────────────────────────────────────
    install -Dm644 "Shelly.Ui.Gpui/assets/calix-gpui.svg" \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/calix-gpui.svg"

    # ── License ──────────────────────────────────────────────────────────────
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE \
            "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi

    # ── Polkit Policy ────────────────────────────────────────────────────────
    install -Dm644 "Shelly.Ui.Gpui/assets/com.calix.calix-gpui.policy" \
        "${pkgdir}/usr/share/polkit-1/actions/com.calix.calix-gpui.policy"
}
