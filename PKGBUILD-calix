# Maintainer: tension-atoi <tension-atoi@users.noreply.github.com>
# Paquet: frontend GPUI natif Rust et service d’inventaire Zig pour Calix —
#          gestionnaire de paquets Arch Linux (ALPM, AUR, Flatpak, AppImage,
#          Cargo, NPM, releases GitHub/GitLab)
#
# Le backend CLI Zig est installé sous /usr/lib/calix/calix ; le frontend
# Calix l'atteint via la variable CALIX_BIN.

pkgname=calix-gpui-git
pkgver=r0.git
pkgrel=1
pkgdesc="Frontend GPUI natif Rust et service d’inventaire Zig pour Calix — gestionnaire de paquets Arch Linux (ALPM, AUR, Flatpak, AppImage)"
arch=('x86_64')
url="https://github.com/tension-atoi/calix"
license=('GPL-3.0-only')
depends=(
    'glibc'
    'gcc-libs'
    'fontconfig'
    'freetype2'
    'libx11'
    'libxcb'
    'libxkbcommon'
    'libxkbcommon-x11'
    'wayland'
    'libglvnd'
    'mesa'
    'vulkan-icd-loader'
    'pacman'
    'polkit'
    'dbus'
)
makedepends=(
    'git'
    'rust'
    'cargo'
    'zig'
    'pkgconf'
    'clang'
    'flatpak'
)
optdepends=(
    'flatpak: support des applications Flatpak'
    'paru: support AUR via Calix'
    'yay: support AUR alternatif'
)
provides=('calix-gpui')
conflicts=('calix-gpui')
source=("${pkgname}::git+https://github.com/tension-atoi/calix.git#branch=main")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${pkgname}"
    printf "r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "${srcdir}/${pkgname}/Calix.Ui.Gpui"
    cargo fetch --locked
}

build() {
    cd "${srcdir}/${pkgname}"

    # 1. Compile the Zig CLI backend
    # Arch's system Zig has moved past the 0.16 build API this tree uses.
    # Allow an explicit ZIG override so package builders can point at a
    # 0.16 toolchain without changing their system installation.
    local zig_bin="${ZIG:-zig}"
    local zig_version
    if ! zig_version="$("$zig_bin" version 2>/dev/null)"; then
        echo "error: cannot run Zig toolchain: ${zig_bin}" >&2
        echo "       set ZIG to the absolute path of a Zig 0.16 binary" >&2
        return 1
    fi
    if [[ "${zig_version}" != 0.16.* ]]; then
        echo "error: Calix requires Zig 0.16.x; ${zig_bin} reports ${zig_version}" >&2
        echo "       set ZIG to the absolute path of a Zig 0.16 binary" >&2
        return 1
    fi

    echo ">>> Compiling the Zig CLI backend with Zig ${zig_version}..."
    cd Calix.Cli.Zig
    "$zig_bin" build -Doptimize=ReleaseSafe
    cd ..

    # 2. Compile the optional Flatpak backend.
    # The CLI loads this library at runtime. Without it the Flatpak
    # ecosystem contributes nothing and the rest of Calix still works, so
    # the library is shipped but the Flatpak runtime stays optional.
    echo ">>> Compiling the Calix Flatpak backend with Zig ${zig_version}..."
    cd Calix.Flatpak.Backend
    "$zig_bin" build -Doptimize=ReleaseSafe
    cd ..

    # 3. Compile the Calix GPUI frontend (Rust)
    echo ">>> Compiling the Calix GPUI frontend (Rust)..."
    cd Calix.Ui.Gpui
    export CARGO_TARGET_DIR="target"
    CALIX_BIN="${srcdir}/${pkgname}/Calix.Cli.Zig/zig-out/bin/calix" \
        cargo build --release --locked
}

check() {
    cd "${srcdir}/${pkgname}/Calix.Ui.Gpui"
    export CARGO_TARGET_DIR="target"
    CALIX_BIN="${srcdir}/${pkgname}/Calix.Cli.Zig/zig-out/bin/calix" \
        cargo test --release --locked
}

package() {
    cd "${srcdir}/${pkgname}"

    # ── Binaries ─────────────────────────────────────────────────────────────
    install -Dm755 "Calix.Cli.Zig/zig-out/bin/calix" \
        "${pkgdir}/usr/lib/calix/calix"
    install -Dm755 "Calix.Cli.Zig/zig-out/bin/calix-daemon" \
        "${pkgdir}/usr/lib/calix/calix-daemon"
    install -Dm755 "Calix.Cli.Zig/zig-out/bin/calix-notify" \
        "${pkgdir}/usr/lib/calix/calix-notify"

    # The binaries are also reachable on PATH; polkit and the user services
    # keep the canonical lib paths.
    install -dm755 "${pkgdir}/usr/bin"
    ln -s /usr/lib/calix/calix "${pkgdir}/usr/bin/calix"
    ln -s /usr/lib/calix/calix-daemon "${pkgdir}/usr/bin/calix-daemon"
    ln -s /usr/lib/calix/calix-notify "${pkgdir}/usr/bin/calix-notify"

    install -Dm755 "Calix.Ui.Gpui/target/release/calix-gpui" \
        "${pkgdir}/usr/lib/calix/calix-gpui"

    # The optional Flatpak backend. The CLI loads it from this exact path at
    # runtime; the versioned library and its SONAME link are what the loader
    # asks for, and the unversioned link keeps the library usable by a
    # third-party consumer that links against it.
    install -Dm755 "Calix.Flatpak.Backend/zig-out/lib/libcalix-flatpak-backend.so.1.0.0" \
        "${pkgdir}/usr/lib/calix/libcalix-flatpak-backend.so.1.0.0"
    ln -s libcalix-flatpak-backend.so.1.0.0 \
        "${pkgdir}/usr/lib/calix/libcalix-flatpak-backend.so.1"
    ln -s libcalix-flatpak-backend.so.1 \
        "${pkgdir}/usr/lib/calix/libcalix-flatpak-backend.so"

    # Wrapper /usr/bin/calix-gpui setting CALIX_BIN and executing the binary
    install -dm755 "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/calix-gpui" << 'EOF'
#!/bin/sh
CALIX_BIN=/usr/lib/calix/calix exec /usr/lib/calix/calix-gpui "$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/calix-gpui"

    # ── Desktop Entry ────────────────────────────────────────────────────────
    install -Dm644 "Calix.Ui.Gpui/assets/live.gnu6.calix.desktop" \
        "${pkgdir}/usr/share/applications/live.gnu6.calix.desktop"

    # ── SVG Icon ─────────────────────────────────────────────────────────────
    install -Dm644 "Calix.Ui.Gpui/assets/live.gnu6.calix.svg" \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/live.gnu6.calix.svg"

    # ── License ──────────────────────────────────────────────────────────────
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE \
            "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi

    # ── Polkit Policy ────────────────────────────────────────────────────────
    install -Dm644 "Calix.Ui.Gpui/assets/live.gnu6.calix.policy" \
        "${pkgdir}/usr/share/polkit-1/actions/live.gnu6.calix.policy"

    # ── User Services ────────────────────────────────────────────────────────
    install -Dm644 "packaging/systemd/calix-daemon.service" \
        "${pkgdir}/usr/lib/systemd/user/calix-daemon.service"
    install -Dm644 "packaging/systemd/calix-notify.service" \
        "${pkgdir}/usr/lib/systemd/user/calix-notify.service"
}
