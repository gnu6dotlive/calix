  "findings": [
    {
      "id": "F1",
      "summary": "The filters act in all three package scopes, but the controls that change them are rendered in Browse only.",
      "where": "views/package_workstation.rs:610-628 applies source_scope, state_filter and sort_mode to every destination; views/package_workstation.rs:673 renders the query workbench for Browse only.",
      "consequence": "A filter set in Browse silently governs Installed and Updates, in surfaces that show no control and no summary.",
      "captured_in": [
        "browse-results.png",
        "installed.png",
        "updates.png"
      ]
    },
    {
      "id": "F2",
      "summary": "The workstation's geometry is computed from the window bounds it knows when it renders, and is not recomputed when the compositor resizes the window.",
      "where": "views/workspace.rs:1936 caches the workstation element (self.workstation.clone()), so a resize does not re-render it; views/package_workstation.rs:558-570 derives the widths from window.window_bounds().",
      "measurements": [
        {
          "window_mapped_px": 1056,
          "list_pane_px": 724,
          "inspector_px": 137,
          "inspector_cap_px": 371,
