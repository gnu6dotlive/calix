+/// A borrowed command-encoding capability for one GPUI frame.
+pub struct GpuFrame<'ctx, 'pass> {
+    gpu: &'ctx gpu::Context,
+    pass: &'pass mut gpu::RenderCommandEncoder<'ctx>,
+    extent: gpu::Extent,
+    format: gpu::TextureFormat,
+}
+
+impl<'ctx, 'pass> GpuFrame<'ctx, 'pass> {
+    pub(crate) fn new(
+        gpu: &'ctx gpu::Context,
+        pass: &'pass mut gpu::RenderCommandEncoder<'ctx>,
+        extent: gpu::Extent,
+        format: gpu::TextureFormat,
+    ) -> Self {
+        Self {
+            gpu,
+            pass,
+            extent,
+            format,
+        }
+    }
+
+    /// Returns the existing GPUI Blade context for this frame only.
+    pub fn context(&self) -> &gpu::Context {
+        self.gpu
+    }
+
+    /// Returns the active render pass for this frame only.
+    pub fn render_pass(&mut self) -> &mut gpu::RenderCommandEncoder<'ctx> {
+        self.pass
+    }
+
+    /// Returns the active frame extent.
+    pub fn extent(&self) -> gpu::Extent {
+        self.extent
+    }
+
+    /// Returns the active frame color format.
+    pub fn target_format(&self) -> gpu::TextureFormat {
+        self.format
+    }
+
+    /// Applies a GPU scissor to subsequent custom draws.
+    pub fn set_scissor_rect(&mut self, rect: gpu::ScissorRect) {
+        self.pass.set_scissor_rect(&rect);
+    }
+}
+
+/// Work submitted by an application for one renderer frame.
