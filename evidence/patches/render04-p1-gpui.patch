+}
+
+impl<'ctx, 'pass> GpuFrame<'ctx, 'pass> {
+    pub(crate) fn new(
+        gpu: &'ctx gpu::Context,
+        pass: &'pass mut gpu::RenderCommandEncoder<'ctx>,
+        local_focus_pipeline: &'pass gpu::RenderPipeline,
+        extent: gpu::Extent,
+        format: gpu::TextureFormat,
+    ) -> Self {
+        Self {
+            gpu,
+            pass,
+            local_focus_pipeline,
+            extent,
+            format,
+        }
+    }
+
+    /// Returns the existing GPUI Blade context for this frame only.
+    pub fn context(&self) -> &gpu::Context {
+        self.gpu
+    }
+
+    /// Returns the active render pass for this frame only.
+    pub fn render_pass(&mut self) -> &mut gpu::RenderCommandEncoder<'ctx> {
+        self.pass
+    }
+
+    /// Returns the active frame extent.
+    pub fn extent(&self) -> gpu::Extent {
+        self.extent
+    }
+
+    /// Returns the active frame color format.
+    pub fn target_format(&self) -> gpu::TextureFormat {
+        self.format
+    }
+
+    /// Applies a GPU scissor to subsequent custom draws.
+    pub fn set_scissor_rect(&mut self, rect: gpu::ScissorRect) {
+        self.pass.set_scissor_rect(&rect);
+    }
+
+    /// Draws the P1 local-focus specimen using the renderer-owned pipeline.
+    pub fn draw_local_focus(
+        &mut self,
+        origin: [f32; 2],
+        size: [f32; 2],
+        center: [f32; 2],
+        inner_radius: f32,
+        outer_radius: f32,
+        intensity: f32,
+        base: [f32; 3],
+    ) {
+        let params = LocalFocusParams {
+            bounds: [origin[0], origin[1], size[0], size[1]],
+            focus: [center[0], center[1], inner_radius, outer_radius],
+            color: [intensity, base[0], base[1], base[2]],
+        };
+        let mut encoder = self.pass.with(self.local_focus_pipeline);
+        encoder.bind(0, &LocalFocusData { params });
+        encoder.draw(0, 3, 0, 1);
+    }
+}
