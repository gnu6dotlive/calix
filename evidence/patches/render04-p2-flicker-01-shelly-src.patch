+pub fn energized_wire_reference() -> Result<Arc<RenderImage>, String> {
+    let bytes = include_bytes!(
+        "../../../docs/gpui/render-lab/references/atlas/crops/optical.energized-wire-glow.png"
+    );
+    let image = image::load_from_memory(bytes)
+        .map_err(|error| format!("energized-wire reference decode failed: {error}"))?
+        .to_rgba8();
+    Ok(Arc::new(RenderImage::new(vec![Frame::new(image)])))
+}
+
+pub fn energized_wire_shader_probe(width: f32, height: f32) -> impl IntoElement {
+    div()
+        .id(SharedString::from(format!(
+            "render04_p2_energized_wire_{width}x{height}"
+        )))
+        .relative()
+        .w(px(width))
+        .h(px(height))
+        .bg(rgb(0x140f0a))
+        .child(
+            canvas(
+                |_bounds, _window, _cx| {},
+                move |bounds, _, window, _cx| {
+                    let paint_seq = P2_B_PAINT_SEQ.fetch_add(1, Ordering::Relaxed) + 1;
+                    log::info!("P2_B_PAINT seq={paint_seq}");
+                    let points = [
+                        [0.81_f32, 0.21_f32],
+                        [0.81_f32, 0.47_f32],
+                        [0.79_f32, 0.53_f32],
+                        [0.67_f32, 0.71_f32],
+                        [0.43_f32, 1.00_f32],
+                    ];
+                    let width: f32 = bounds.size.width.into();
+                    let height: f32 = bounds.size.height.into();
+                    let ox: f32 = bounds.origin.x.into();
+                    let oy: f32 = bounds.origin.y.into();
+
+                    let mut path = PathBuilder::stroke(px(3.0));
+                    path.move_to(point(
+                        px(ox + width * points[0][0]),
+                        px(oy + height * points[0][1]),
+                    ));
+                    for p in points.iter().skip(1) {
+                        path.line_to(point(px(ox + width * p[0]), px(oy + height * p[1])));
+                    }
+                    if let Ok(core) = path.build() {
+                        window.paint_path(core, rgb(0xfff8d0));
+                    }
+
+                    let scale = window.scale_factor();
+                    let origin = [ox * scale, oy * scale];
+                    let size = [width * scale, height * scale];
+                    let scissor = blade_graphics::ScissorRect {
+                        x: origin[0].max(0.0) as i32,
+                        y: origin[1].max(0.0) as i32,
+                        w: size[0].max(1.0) as u32,
+                        h: size[1].max(1.0) as u32,
+                    };
+                    log::info!(
+                        "P2 energized-wire B bounds x={} y={} w={} h={} scale={}",
+                        origin[0],
+                        origin[1],
+                        size[0],
+                        size[1],
+                        scale
+                    );
+                    window.enqueue_gpu_frame_callback(move |frame| {
+                        log::info!("P2_B_CALLBACK seq={paint_seq}");
+                        frame.set_scissor_rect(scissor);
+                        frame.draw_energized_wire(
+                            origin,
+                            size,
+                            points,
+                            1.5 * scale,
+                            32.0 * scale,
+                            0.72,
+                            [1.0, 0.52, 0.08],
+                        );
+                    });
+                    log::info!("P2_B_ENQUEUE seq={paint_seq}");
+                },
+            )
+            .size_full(),
+        )
+}
