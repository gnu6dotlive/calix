 };
 use gpui::RenderImage;
+use gpui::*;
 use image::{Frame, RgbaImage};
 use std::sync::{Arc, OnceLock};
 use std::time::Instant;
@@ -49,6 +50,66 @@ pub struct ShaderProbeOutput {
 
 static PROBE: OnceLock<Result<ShaderProbeOutput, String>> = OnceLock::new();
 
+static LOCAL_FOCUS_REFERENCE: OnceLock<Result<Arc<RenderImage>, String>> = OnceLock::new();
+
+pub fn local_focus_reference() -> &'static Result<Arc<RenderImage>, String> {
+    LOCAL_FOCUS_REFERENCE.get_or_init(|| {
+        let bytes = include_bytes!("../../../docs/gpui/render-lab/references/atlas/crops/optical.local-focus.png");
+        let image = image::load_from_memory(bytes)
+            .map_err(|error| format!("local-focus reference decode failed: {error}"))?
+            .to_rgba8();
+        Ok(Arc::new(RenderImage::new(vec![Frame::new(image)])))
+    })
+}
+
+pub fn local_focus_shader_probe() -> impl IntoElement {
+    local_focus_shader_probe_sized(220.0, 170.0)
+}
+
+pub fn local_focus_shader_probe_sized(width: f32, height: f32) -> impl IntoElement {
+    div()
+        .id(SharedString::from(format!(
+            "render04_p1_local_focus_shader_{}x{}",
+            width, height
+        )))
+        .w(px(width))
+        .h(px(height))
+        .bg(rgb(0x0e141c))
+        .child(canvas(
+            |_bounds, _window, _cx| {},
+            |bounds, _, window, _cx| {
+                let scale = window.scale_factor();
+                let origin = [
+                    f32::from(bounds.origin.x) * scale,
+                    f32::from(bounds.origin.y) * scale,
+                ];
+                let size = [
+                    f32::from(bounds.size.width) * scale,
+                    f32::from(bounds.size.height) * scale,
+                ];
+                let scissor = blade_graphics::ScissorRect {
+                    x: origin[0].max(0.0) as i32,
+                    y: origin[1].max(0.0) as i32,
+                    w: size[0].max(1.0) as u32,
+                    h: size[1].max(1.0) as u32,
+                };
+                window.enqueue_gpu_frame_callback(move |frame| {
+                    frame.set_scissor_rect(scissor);
+                    frame.draw_local_focus(
+                        origin,
+                        size,
+                        [0.5, 0.5],
+                        0.08,
+                        0.55,
+                        0.72,
+                        [0.0549, 0.0784, 0.1098],
+                    );
+                });
+            },
+        )
+        .size_full())
+}
+
 pub fn shader_present_probe() -> &'static Result<ShaderProbeOutput, String> {
     PROBE.get_or_init(render_shader_once)
 }
