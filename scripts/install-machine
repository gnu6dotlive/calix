#!/usr/bin/env bash
# The machine, as a target.
#
# Installing Calix is not "copy the binaries": a package must replace the
# previous one, the services must serve the *new* code rather than the old
# one still in memory, and the result must be checked — not assumed.
#
#   scripts/install-machine            # build from main, install, restart, verify
#   scripts/install-machine --from-local
#                                       # build from *this* tree — the way a
#                                       # change is tried on the machine
#                                       # before it is merged
#   scripts/install-machine --dry-run  # everything but the installation
#
# The steps, in order:
#
#   1. the tree is clean, on main, and in step with the remote;
#   2. the package is built (the repository's own PKGBUILD, in the
#      repository's own scratch);
#   3. the package is installed, replacing the previous one, through
#      polkit — never sudo;
#   4. the user services are restarted, so that they serve the new code;
#   5. the installation is *verified*: the package's files are the new
#      ones, the binaries answer, the daemon answers, the services run the
#      new code;
#   6. the run is recorded in `evidence/runs/install-<date>/`.
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT"

DRY_RUN=0
FROM_LOCAL=0
PKGDIR="$ROOT/.ci-cache/pkg"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1 ;;
        --from-local) FROM_LOCAL=1 ;;
        -h | --help)
            sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "install-machine: unknown argument: $1" >&2
            exit 2
            ;;
    esac
    shift
done

STEP=0
step() {
    STEP=$((STEP + 1))
    printf '\n[%d] %s\n' "$STEP" "$1"
}
fail() {
    echo "install-machine: $1" >&2
    exit 1
}

# ── 1. The tree ────────────────────────────────────────────────────────────
step "The tree"
if [[ -n "$(git status --porcelain)" ]]; then
    fail "the working tree is dirty — commit or stash first"
fi
BRANCH=$(git branch --show-current)
if [[ $FROM_LOCAL -eq 0 && "$BRANCH" != "main" ]]; then
    fail "the installation comes from main (on '${BRANCH}'); --from-local installs this tree"
fi
if [[ $FROM_LOCAL -eq 1 && "$BRANCH" == "main" ]]; then
    echo "install-machine: --from-local on main is the same as the published path"
fi
git fetch --quiet origin
LOCAL=$(git rev-parse HEAD)
# The branch is compared with *its* remote counterpart: the local path
# installs a branch before it is merged, and the published path installs
# main.
REMOTE_REF="origin/$BRANCH"
[[ "$BRANCH" == "main" ]] && REMOTE_REF="origin/main"
[[ "$LOCAL" == "$(git rev-parse "$REMOTE_REF")" ]] || fail "the branch is not in step with the remote (${LOCAL} vs ${REMOTE_REF})"
echo "  main is at ${LOCAL}"

# ── 2. The package ─────────────────────────────────────────────────────────
step "The package"
if [[ $DRY_RUN -eq 1 ]]; then
    if [[ $FROM_LOCAL -eq 1 ]]; then
        echo "  would build the package from this tree with scripts/package-build --from-local"
    else
        echo "  would build the package from PKGBUILD-calix with scripts/package-build"
    fi
else
    # Staging is not repeated here. `scripts/package-build` owns which files
    # enter the build tree and which source the PKGBUILD points at; a second
    # copy of that logic is how the cached PKGBUILD drifted onto another
    # branch and its clone then refused to build.
    if [[ $FROM_LOCAL -eq 1 ]]; then
        PACKAGE=$("$ROOT/scripts/package-build" --from-local)
    else
        PACKAGE=$("$ROOT/scripts/package-build")
    fi
    [[ -n "$PACKAGE" ]] || fail "the package was not built"
    echo "  built $(basename "$PACKAGE")"
fi

# ── 3. The installation ─────────────────────────────────────────────────────
step "The installation"
if [[ $DRY_RUN -eq 1 ]]; then
    echo "  would install the package with pkexec pacman -U (never sudo)"
else
    # pacman replaces the previous package: its obsolete files go with it.
    pkexec pacman -U --noconfirm "$PACKAGE" || fail "the installation failed"
    echo "  installed"
fi

# ── 4. The services ────────────────────────────────────────────────────────
step "The services"
if [[ $DRY_RUN -eq 1 ]]; then
    echo "  would restart calix-daemon and calix-notify, so that they serve the new code"
else
    # A service that was running yesterday's binary keeps it in memory: the
    # upgrade does not restart it. This is the step that is easy to forget,
    # and the step whose absence is invisible until a bug is chased.
    systemctl --user restart calix-daemon.service calix-notify.service
    sleep 2
    for unit in calix-daemon.service calix-notify.service; do
        state=$(systemctl --user is-active "$unit" || true)
        [[ "$state" == "active" ]] || fail "${unit} is ${state} after the restart"
    done
    echo "  both services are running the new code"
fi

# ── 5. The verification ────────────────────────────────────────────────────
step "The verification"
if [[ $DRY_RUN -eq 1 ]]; then
    echo "  would verify the package, the binaries, the daemon and the services"
else
    # The package's own files: none altered, none missing. The lines that
    # name a file are the ones that matter — the summary line ends with "0
    # altered files" and would match a naive grep on the word.
    ALTERED=$(pacman -Qkk calix-gpui-git 2>&1 | grep -cE "^calix-gpui-git: /" || true)
    [[ "$ALTERED" -eq 0 ]] || fail "${ALTERED} files of the package differ from the package's"
    echo "  the package's files are the new ones"

    # The binaries answer.
    /usr/lib/calix/calix --version >/dev/null 2>&1 || fail "the CLI does not answer"
    /usr/lib/calix/calix-gpui --help >/dev/null 2>&1 || fail "the frontend does not answer"
    echo "  the binaries answer"

    # The daemon answers, and the answer is the new code's.
    if command -v systemctl >/dev/null 2>&1; then
        timeout 60 /usr/bin/calix list-updates standard -j >/dev/null 2>&1 ||
            fail "the daemon does not answer"
        echo "  the daemon answers"
    fi

    # The services run the code that is on disk now — not the inode they were
    # started from before this upgrade. A non-zero PID proves a process
    # exists, not which binary it is: after an upgrade /proc/<pid>/exe points
    # at the deleted inode and the hashes differ. This is the check that the
    # claim in the line above is actually true.
    for unit in calix-daemon.service calix-notify.service; do
        pid=$(systemctl --user show "$unit" --property MainPID --value 2>/dev/null || echo 0)
        [[ "$pid" != "0" ]] || fail "${unit} has no process"
        exe=$(readlink "/proc/${pid}/exe")
        [[ "$exe" != *"(deleted)"* ]] || fail "${unit} still runs a deleted inode (${exe})"
        installed="/usr/lib/calix/${unit%.service}"
        running_hash=$(sha256sum <"/proc/${pid}/exe" | cut -d' ' -f1)
        installed_hash=$(sha256sum <"$installed" | cut -d' ' -f1)
        [[ "$running_hash" == "$installed_hash" ]] ||
            fail "${unit} runs a binary that is not the installed one"
    done
    echo "  the services run the installed code"
fi

# ── 6. The record ───────────────────────────────────────────────────────────
step "The record"
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
EVIDENCE="$ROOT/evidence/runs/install-${STAMP}"
if [[ $DRY_RUN -eq 1 ]]; then
    echo "  would record the run in ${EVIDENCE}"
else
    mkdir -p "$EVIDENCE"
    PACKAGE_NAME=$(basename "${PACKAGE:-unknown}")
    cat >"${EVIDENCE}/run.json" <<EOF
{
  "run_id": "install-${STAMP}",
  "kind": "installation",
  "status": "ok",
  "commit": "${LOCAL}",
  "package": "${PACKAGE_NAME}",
  "the_checks": [
    "the working tree was clean, on main, and in step with the remote",
    "the package was built by the repository's own PKGBUILD",
    "the package replaced the previous one, through polkit",
    "the user services were restarted, so that they serve the new code",
    "no file of the package differs from the package's",
    "the binaries and the daemon answer",
    "the services run"
  ]
}
EOF
    echo "  recorded in ${EVIDENCE}/run.json"
fi

echo
echo "install-machine: done."
