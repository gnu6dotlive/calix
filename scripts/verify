#!/usr/bin/env bash
# The one definition of "green".
#
# Local proof has to mean the same thing as CI, or it is a guess about what
# CI will do. This script is that definition: the pre-push hook runs it, and
# the workflow runs the same file rather than a copy of its steps.
#
# What it adds over `ci.yml` as it stood:
#   - the PackageManager suite, which CI never ran;
#   - a Zig version check, because the repository is built with 0.16 and a
#     newer system Zig fails in ways that look like source errors;
#   - a floor on the number of tests that actually ran, so a harness that
#     silently executes nothing cannot pass;
#   - the Rust suite in the release profile, so CI compiles one dependency
#     graph rather than a debug graph and a release graph;
#   - a machine-readable record of the run, so "it passed locally" is a
#     file and not a claim.
#
# Usage:
#   scripts/verify            # everything
#   scripts/verify --quick    # skip the two release builds
#
# Exits non-zero on the first failing step. `git push --no-verify` exists;
# using it is a decision the pusher owns, not something this script hides.

set -uo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT" || exit 1

QUICK=0
for argument in "$@"; do
    case "$argument" in
        --quick) QUICK=1 ;;
        --help | -h)
            sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "verify: unknown argument: $argument" >&2
            exit 2
            ;;
    esac
done

command -v python3 >/dev/null 2>&1 || {
    echo "verify: python3 is required; the run record is written by it." >&2
    exit 1
}

# The scratch of the run belongs to the repository, not to the shared tmpfs.
#
# /tmp is a memory-backed filesystem of sixteen gigabytes that every session on
# the machine shares. A suite that writes its scratch there can fail with
# ENOSPC because of somebody else's leftovers, which is a failure of the
# environment, not of the code — and a failure of the environment looks exactly
# like a failure of the code. The scratch goes under .ci-cache/, which the
# repository ignores.
mkdir -p "$ROOT/.ci-cache/tmp"
export TMPDIR="$ROOT/.ci-cache/tmp"

# ---- the floors -------------------------------------------------------------
#
# These are not targets, they are tripwires. A suite that suddenly runs 300
# tests instead of 380 is not "faster", it is a suite that stopped being
# compiled or collected. Raise a floor when the real count grows; never lower
# one to make a run pass.
PACKAGEMANAGER_FLOOR=1380
CLI_FLOOR=380
RUST_FLOOR=195

# ---- plumbing ---------------------------------------------------------------

RUN_ID="local-verify-$(date -u +%Y%m%dT%H%M%SZ)"
# Operational, not research: this is a gate, not an experiment, so its record
# belongs with the other operational records in the state directory rather
# than in the repository's evidence tree.
RECORD_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/calix/verify/$RUN_ID"
LOG_DIR="$RECORD_DIR/logs"
mkdir -p "$LOG_DIR" || exit 1

STARTED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
DIRTY=0
if [ -n "$(git status --porcelain 2>/dev/null)" ]; then DIRTY=1; fi

STEP_NAMES=()
STEP_STATUS=()
STEP_MS=()

now_ms() { date +%s%3N; }

step() {
    local name="$1"
    shift
    local started finished elapsed log
    started=$(now_ms)
    log="$LOG_DIR/$name.log"
    printf '  %-32s ' "$name"
    if "$@" >"$log" 2>&1; then
        finished=$(now_ms)
        elapsed=$((finished - started))
        printf 'ok   (%ss)\n' "$((elapsed / 1000))"
        STEP_NAMES+=("$name")
        STEP_STATUS+=("ok")
        STEP_MS+=("$elapsed")
    else
        finished=$(now_ms)
        elapsed=$((finished - started))
        printf 'FAIL (%ss)\n' "$((elapsed / 1000))"
        echo
        echo "  ---- $name ----"
        tail -n 40 "$log" | sed 's/^/  /'
        echo "  ---- end ----"
        STEP_NAMES+=("$name")
        STEP_STATUS+=("failed")
        STEP_MS+=("$elapsed")
        finish failed
    fi
}

# Reads "Build Summary: ... 1386/1390 tests passed" from a zig build log.
zig_test_count() {
    grep -oE '[0-9]+/[0-9]+ tests passed' "$1" | tail -n 1 | cut -d/ -f1
}

# Reads "test result: ok. 201 passed" from a cargo test log.
rust_test_count() {
    grep -oE 'test result: ok\. [0-9]+ passed' "$1" | tail -n 1 | awk '{print $4}'
}

require_count() {
    local label="$1" count="$2" floor="$3"
    if [ -z "$count" ]; then
        echo "verify: $label ran no tests, and the log does not say why" >&2
        return 1
    fi
    if [ "$count" -lt "$floor" ]; then
        echo "verify: $label ran $count tests, below the floor of $floor." >&2
        echo "verify: a suite that stopped running its tests is not a passing suite." >&2
        return 1
    fi
    printf '  %-32s %s tests (>%s)\n' "$label" "$count" "$floor"
}

finish() {
    local status="$1"  # "ok" or "failed"
    local finished_at
    finished_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    python3 - "$RECORD_DIR/run.json" "$RUN_ID" "$status" "$STARTED_AT" "$finished_at" \
        "$COMMIT" "$DIRTY" "${#STEP_NAMES[@]}" \
        "${STEP_NAMES[@]}" "${STEP_STATUS[@]}" "${STEP_MS[@]}" <<'PY'
import json, sys
path, run_id, status, started, finished, commit, dirty, count = sys.argv[1:9]
count = int(count)
values = sys.argv[9:]
names = values[:count]
statuses = values[count:count * 2]
durations = values[count * 2:count * 3]
steps = [
    {"name": name, "status": state, "duration_ms": int(ms)}
    for name, state, ms in zip(names, statuses, durations)
]
record = {
    "run_id": run_id,
    "kind": "local-verify",
    "status": status,
    "ok": status == "ok",
    "started_at": started,
    "finished_at": finished,
    "commit": commit,
    "working_tree_dirty": dirty == "1",
    "steps": steps,
    "note": "A dirty tree means this is a development run, not proof of the commit.",
}
with open(path, "w") as handle:
    json.dump(record, handle, indent=2)
    handle.write("\n")
PY
    echo
    if [ "$status" = "ok" ] && [ "$DIRTY" = "1" ]; then
        echo "verify: PASSED on a dirty tree — this proves the checkout, not the commit."
    elif [ "$status" = "ok" ]; then
        echo "verify: PASSED at $COMMIT."
    else
        echo "verify: FAILED at $COMMIT."
    fi
    echo "verify: record $RECORD_DIR/run.json"
    [ "$status" = "ok" ] || exit 1
    exit 0
}

# ---- Zig, exactly once ------------------------------------------------------

zig_path() {
    if [ -x "$ROOT/vendor/zig-0.16/usr/bin/zig" ]; then
        printf '%s\n' "$ROOT/vendor/zig-0.16/usr/bin/zig"
        return 0
    fi
    command -v zig || {
        echo "verify: no zig on PATH and no vendor/zig-0.16" >&2
        return 1
    }
}

ZIG=$(zig_path) || exit 1
ZIG_VERSION=$("$ZIG" version 2>/dev/null)
case "$ZIG_VERSION" in
    0.16.*) ;;
    *)
        echo "verify: this repository targets Zig 0.16, but $ZIG is $ZIG_VERSION." >&2
        echo "verify: extract the 0.16 package into vendor/zig-0.16 (see docs/calix-architecture.md)." >&2
        exit 1
        ;;
esac
export PATH="$(dirname "$ZIG"):$PATH"

echo "verify: $RUN_ID"
echo "verify: zig $ZIG_VERSION ($ZIG)"
echo "verify: commit $COMMIT$([ "$DIRTY" = 1 ] && echo ' (dirty)')"
echo

# ---- the steps --------------------------------------------------------------

packagemanager_tests() {
    (cd Calix.PackageManager && zig build test --summary all)
}

cli_tests() {
    (cd Calix.Cli.Zig && zig build test --summary all)
}

naming_check() {
    scripts/check-naming
}

cli_release_build() {
    (cd Calix.Cli.Zig && zig build -Doptimize=ReleaseSafe)
}

# The optional Flatpak backend is a separate shared library that the CLI
# loads at runtime, and the package ships it. A build that produces no
# library would ship a package whose Flatpak support silently never works,
# so the gate builds it and checks that the library is there.
flatpak_backend_tests() {
    (cd Calix.Flatpak.Backend && zig build test --summary all)
}

flatpak_backend_release_build() {
    (cd Calix.Flatpak.Backend && zig build -Doptimize=ReleaseSafe)
    test -f Calix.Flatpak.Backend/zig-out/lib/libcalix-flatpak-backend.so.1
}

# The flags a build inherits decide what the binary *is*, and three of the
# flags that reach a build by default are wrong for a distributed package.
# Each of them fails in a way that hides its own cause, which is why they
# are checked where they enter — before the build — rather than read out of
# a linker error afterwards:
#
#   -flto=auto (CFLAGS/CXXFLAGS/LDFLAGS, which makepkg's global `lto`
#   option adds) reaches the C shim that wayland-backend's build script
#   compiles. The object then carries LTO bytecode instead of code, and
#   rust-lld cannot read it: the link fails with
#     undefined symbol: wl_log_trampoline_to_rust_client
#
#   -C opt-level=3 (RUSTFLAGS) is not merely redundant: rustc enables
#   cfg(debug_assertions) only when opt-level is 0, so the flag switches
#   the debug assertions off — in the test profile too. gpui records the
#   bounds of an element only under
#   all(debug_assertions, feature = "test-support"), so the measurements
#   the visual bench reads vanish and the tests that read them fail.
#
#   -C target-cpu=native (RUSTFLAGS) builds the binary for the machine
#   that builds it: LLVM then vectorises a hundred times more, in the
#   widest width that machine has. A package is downloaded by machines
#   that are not this one, and the binary faults with SIGILL where the
#   instructions are absent.
#
# The flags enter a build from two places: the environment, and the
# package's own declaration. Both are checked. The package's declaration
# is asked of the PKGBUILD itself, so the check cannot drift from what
# the package does.
build_flags() {
    local pkg_rust pkg_c pkg_cxx pkg_ld
    local rust_flags="${RUSTFLAGS:-}" c_flags="${CFLAGS:-}"
    local cxx_flags="${CXXFLAGS:-}" ld_flags="${LDFLAGS:-}"

    if ! pkg_rust=$(cd "$ROOT" && bash -c 'source ./PKGBUILD-calix >/dev/null 2>&1 || exit 1
        package_build_flags || exit 1
        printf "%s\n" "$RUSTFLAGS"') || [ -z "$pkg_rust" ]; then
        echo "build-flags: the package's flags could not be read from PKGBUILD-calix" >&2
        return 1
    fi
    pkg_c=$(cd "$ROOT" && bash -c 'source ./PKGBUILD-calix >/dev/null 2>&1
        package_build_flags; printf "%s\n" "$CFLAGS"')
    pkg_cxx=$(cd "$ROOT" && bash -c 'source ./PKGBUILD-calix >/dev/null 2>&1
        package_build_flags; printf "%s\n" "$CXXFLAGS"')
    pkg_ld=$(cd "$ROOT" && bash -c 'source ./PKGBUILD-calix >/dev/null 2>&1
        package_build_flags; printf "%s\n" "$LDFLAGS"')

    local failed=0
    # where the flags come from, the flags, and the message
    check_one_flag() {
        local where="$1" name="$2" value="$3" pattern="$4" why="$5"
        if printf '%s' "$value" | grep -qE "$pattern"; then
            echo "build-flags: $where carries $name" >&2
            echo "             $why" >&2
            failed=1
        fi
    }

    local native='target-cpu=native'
    local optlevel='(^|[[:space:]])-C[[:space:]]*opt-level='
    local lto='(^|[[:space:]])-flto'

    for where in "the environment" "the package's declaration"; do
        local r="$rust_flags" c="$c_flags" x="$cxx_flags" l="$ld_flags"
        if [ "$where" = "the package's declaration" ]; then
            r="$pkg_rust"; c="$pkg_c"; x="$pkg_cxx"; l="$pkg_ld"
        fi
        check_one_flag "$where" "-C target-cpu=native" "$r" "$native" \
            "a distributed package is built for the architecture's baseline, not for the machine that builds it"
        check_one_flag "$where" "-C opt-level=" "$r" "$optlevel" \
            "rustc enables cfg(debug_assertions) only when opt-level is 0, so this switches the measurements off"
        check_one_flag "$where" "-flto" "$c $x $l" "$lto" \
            "the C shim that wayland-backend compiles would become LTO bytecode, which rust-lld cannot read"
    done

    if [ "$failed" != 0 ]; then
        echo "build-flags: the build is refused; the package's own flags are in PKGBUILD-calix" >&2
        return 1
    fi

    printf 'the environment: RUSTFLAGS=%s\n' "${rust_flags:-<none>}"
    printf 'the package:     RUSTFLAGS=%s\n' "$pkg_rust"
    printf 'the package:     CFLAGS=%s\n' "$pkg_c"
    printf 'the package:     LDFLAGS=%s\n' "$pkg_ld"
}

# The package's *metadata* is part of the gate: the files it declares and
# the dependencies it names are what the machine receives.
#
# The package itself is not built here — that is the release's business,
# and it costs minutes. What is checked is what the package *says*: the
# file list its package() function produces, and the libraries its
# binaries actually need against the dependencies it declares. A package
# that uses a library it does not declare installs, and then fails to
# start, on a machine that lacks that library — and nothing else in the
# gate would notice.
#
# The file list is produced by *running* package(), in a scratch
# directory, against the tree this gate has built. A source that is not
# there makes install fail, so the list is proven to exist rather than
# parsed and hoped for.
package_metadata() {
    local scratch="$ROOT/.ci-cache/pkgmeta"
    local pkgname
    pkgname=$(cd "$ROOT" && bash -c 'source ./PKGBUILD-calix >/dev/null 2>&1; printf "%s" "$pkgname"') || {
        echo "package-metadata: the PKGBUILD's name could not be read" >&2
        return 1
    }
    rm -rf "$scratch"
    mkdir -p "$scratch/pkg" || return 1
    ln -s "$ROOT" "$scratch/$pkgname"

    # Where cargo put the release binary. The package installs it from the
    # tree's own target directory, so that path has to point at the
    # artifact — the shared build directory is somewhere else, and the
    # link lives inside the ignored target/, so the tree stays clean.
    local exe want
    exe=$(cd "$ROOT/Calix.Ui.Gpui" && cargo build --release --locked --message-format=json 2>/dev/null |
        grep -o '"executable":"[^"]*"' | head -1 | cut -d'"' -f4)
    want="$ROOT/Calix.Ui.Gpui/target/release/calix-gpui"
    if [ -n "$exe" ] && [ -x "$exe" ] && [ ! -e "$want" ]; then
        mkdir -p "$(dirname "$want")"
        ln -s "$exe" "$want"
    fi

    if ! (cd "$ROOT" && bash -c '
            set -euo pipefail
            source ./PKGBUILD-calix >/dev/null 2>&1
            srcdir="'"$scratch"'"
            pkgdir="'"$scratch"'/pkg"
            package
        '); then
        echo "package-metadata: package() did not run; a file it installs is missing" >&2
        return 1
    fi

    local files
    files=$(find "$scratch/pkg" -type f -o -type l | wc -l)
    if [ "$files" -lt 10 ]; then
        echo "package-metadata: the package installed $files files; that is not a package" >&2
        return 1
    fi

    # The libraries the shipped binaries need, and the package that owns
    # each. The binaries are the required part of the package; the
    # Flatpak backend is the optional one, and its libraries belong to
    # the optional dependency that switches it on.
    local required optional
    required=$(bash -c 'source ./PKGBUILD-calix >/dev/null 2>&1; printf "%s" "${depends[*]}"')
    optional=$(bash -c 'source ./PKGBUILD-calix >/dev/null 2>&1; printf "%s" "${optdepends[*]}"')

    # What a machine that installed the declared dependencies has. The
    # question the check asks is not "do the names match" but "does the
    # package work on such a machine" — and a distribution may split a
    # package (this one splits libgcc_s out of gcc-libs), so the library
    # is looked for in the dependencies' closure.
    local satisfied
    satisfied=$(for dep in $required; do
        printf '%s\n' "$dep"
        # The dependencies of the dependency: "Depends On", which is what
        # the machine will have. The repository's metadata is used when
        # the package is not installed here, so the closure is the same
        # on a build machine and on the machine that installs it.
        pacman -Qi "$dep" 2>/dev/null | sed -n 's/^Depends On *: *//p'
        pacman -Si "$dep" 2>/dev/null | sed -n 's/^Depends On *: *//p'
    done | tr ' ' '\n' | sed 's/[<>=].*//' | grep -v '^$' | sort -u | tr '\n' ' ')

    local missing=0
    local file lib owner
    for file in "$scratch/pkg"/usr/lib/calix/*; do
        [ -f "$file" ] || continue
        # A shared library is the optional part: the CLI loads it at
        # runtime, and the optional dependency names what it needs.
        if [[ "$file" == *.so.* || "$file" == *.so ]]; then
            continue
        fi
        while read -r lib; do
            [ -n "$lib" ] || continue
            owner=$(pacman -Qo "$lib" 2>/dev/null | sed 's/.* is owned by \([^ ]*\).*/\1/')
            [ -n "$owner" ] || continue
            case " $satisfied " in
                *" $owner "*) ;;
                *)
                    echo "package-metadata: $(basename "$file") needs $owner, which the package's dependencies do not bring" >&2
                    missing=1
                    ;;
            esac
        done < <(readelf -d "$file" 2>/dev/null |
            grep NEEDED | sed 's/.*\[\(.*\)\]/\1/' |
            while read -r soname; do
                for dir in /usr/lib /lib /usr/lib64 /lib64; do
                    [ -e "$dir/$soname" ] && { echo "$dir/$soname"; break; }
                done
            done)
    done
    if [ "$missing" != 0 ]; then
        echo "package-metadata: the dependencies are incomplete" >&2
        return 1
    fi

    printf 'the package installs %s files; its dependencies bring what the binaries need\n' "$files"
    printf 'the optional part: %s\n' "${optional:-<none>}"
}

# A released binary has to run on every x86_64 machine, not only on the one
# that built it. Zig's native CPU model bakes the build machine's
# instruction set into the binary, and Zig emits it without a runtime check:
# an AMD-only instruction (SSE4a) in a published binary kills it with
# SIGILL on an Intel CPU the first time it opens a TLS connection. The
# builds resolve the baseline CPU model, and this step makes sure they did.
#
# The Rust frontend is not checked here: Rust compiles for the baseline
# target and dispatches to wider implementations at runtime, so its
# disassembly legitimately contains instructions the baseline lacks.
portable_binaries() {
    local binary
    for binary in \
        Calix.Cli.Zig/zig-out/bin/calix \
        Calix.Cli.Zig/zig-out/bin/calix-daemon \
        Calix.Cli.Zig/zig-out/bin/calix-notify \
        Calix.Flatpak.Backend/zig-out/lib/libcalix-flatpak-backend.so.1.0.0
    do
        if [ ! -f "$binary" ]; then
            echo "portable-binaries: $binary was not built" >&2
            return 1
        fi
        if objdump -d "$binary" | grep -qE '%(y|z)mm[0-9]|extrq'; then
            echo "portable-binaries: $binary uses instructions above the x86_64 baseline" >&2
            return 1
        fi
    done
}

cli_smoke() {
    local output
    output=$(./Calix.Cli.Zig/zig-out/bin/calix --version) || return 1
    printf '%s\n' "$output"
    # A binary that prints nothing, or prints a version it does not have, is
    # not a smoke test.
    printf '%s' "$output" | grep -qE '[0-9]+\.[0-9]+\.[0-9]+'
}

# Tests and the release binary share one release target directory. The old
# debug check/test pair compiled the dependency graph once, then the release
# build compiled it again; that duplicate work was most of a cold CI run.
rust_tests() {
    # The tests run in the *debug* profile, and this is not a preference:
    # gpui 0.3 records the bounds of an element — what the visual bench
    # measures — only under `all(debug_assertions, feature = "test-support")`.
    # A release build has no debug assertions, so the measurements would
    # silently find nothing and the tests that read them would fail.
    #
    # The release build is still made, for the artefact it ships.
    (cd Calix.Ui.Gpui && cargo test --locked --quiet)
}

rust_release_build() {
    (cd Calix.Ui.Gpui && cargo build --release --locked --quiet)
}

step "naming-check" naming_check
step "packagemanager-tests" packagemanager_tests
require_count "package manager" "$(zig_test_count "$LOG_DIR/packagemanager-tests.log")" "$PACKAGEMANAGER_FLOOR" || finish failed

step "cli-tests" cli_tests
require_count "cli" "$(zig_test_count "$LOG_DIR/cli-tests.log")" "$CLI_FLOOR" || finish failed

step "cli-release-build" cli_release_build
step "cli-smoke" cli_smoke
step "flatpak-backend-tests" flatpak_backend_tests
step "flatpak-backend-release-build" flatpak_backend_release_build
step "portable-binaries" portable_binaries
# The package's metadata: the files it declares, and the dependencies it
# names against the libraries its binaries need. The package itself is
# the release's business; what it *says* is the gate's.
step "package-metadata" package_metadata
# The flags are checked before the Rust build, so a flag that would break
# the build (or the binary) is named where it enters, instead of showing
# up later as a linker error or as a fault on another machine.
step "build-flags" build_flags
# The UI resolves the CLI at runtime, so the tests that launch it need to be
# pointed at the binary this run just built rather than one on PATH.
export CALIX_BIN="$ROOT/Calix.Cli.Zig/zig-out/bin/calix"

step "rust-tests" rust_tests
require_count "ui" "$(rust_test_count "$LOG_DIR/rust-tests.log")" "$RUST_FLOOR" || finish failed

if [ "$QUICK" = 0 ]; then
    step "rust-release-build" rust_release_build
else
    echo "  rust-release-build                skipped (--quick)"
fi

finish ok
