#!/usr/bin/env bash
# calix — Universal package manager CLI for the gnosix desktop.
#
# Thin dispatcher over the Calix engine (scripts/calix-release.py) and the
# Zig CLI, plus health reporting.
#
# Installed to ~/.local/bin/calix as a symlink to this file so the CLI is
# version-controlled alongside the engine it drives.
#
# STATUT : GELÉ. This shell dispatcher is a bridge to the Zig backend
# (`calix` + `calix-daemon`), which replaces it in tranche 1 of
# calix-architecture.md. It must not gain new features; a capability added
# here is a capability written twice. It stays only until the Zig CLI
# exists, and the Rust frontend stops calling the engine directly.

set -u

CALIX_HOME="${CALIX_HOME:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
# The AppImage database is a document of its own, written by
# `calix sync appimage` (the Python that mirrored it into state is gone).
CALIX_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/calix"
PYTHON_BIN="${CALIX_BIN:-/usr/bin/python3}"
RELEASE="$CALIX_HOME/scripts/calix-release.py"

show_help() {
  cat <<'EOF'
🏺 Calix — Universal Package Manager (gnosix desktop)

Usage:
  calix <command> [options]

Commands:
  inventory            Print unified package inventory across all ecosystems as JSON.
  releases [--refresh]
                       What is release-tracked, and what the daemon last saw.
                       --refresh asks the daemon to probe now.
  probe <repo_or_url> [--canal stable|beta|canary|nightly|all]
                       Probe a repository's releases, channels and binary assets.
  update <package>     Build and install a newer release through its PKGBUILD
                       (elevation via pkexec — never sudo).
  registry [list|add|remove]
                       Manage the set of release-tracked packages.
  verify <package>     Audit a tracked package against its upstream release
                       (version + checksum manifest).
  health               Audit system health: pacman db.lck, conflicting notifiers.
  gui                  Launch the GPU-accelerated Calix UI (GPUI/Blade).

Options:
  -j, --json           Structured JSON output (machine-readable for agents).
  -h, --help           This help message.

Environment:
  CALIX_HOME           Repository root (default: parent of this script).
  CALIX_BIN            Python interpreter (default: /usr/bin/python3).
EOF
}

count_entries() {
  # Count JSON array/dict entries in a state file.
  local file="$1"
  [ -f "$file" ] || { echo "0"; return; }
  "$PYTHON_BIN" -c "
import json, sys
try:
    data = json.load(open(sys.argv[1]))
except Exception:
    print(0); sys.exit()
if isinstance(data, dict):
    print(len(data))
elif isinstance(data, list):
    print(len(data))
else:
    print(0)
" "$file" 2>/dev/null || echo "0"
}

cmd_health() {
  echo "🏺 Calix System Health Check — $(date -Is)"
  echo ""

  if [ -f /var/lib/pacman/db.lck ]; then
    echo "  Pacman DB Lock:     ✗ LOCKED (/var/lib/pacman/db.lck exists)"
  else
    echo "  Pacman DB Lock:     ✓ Free"
  fi

  local cachy_state
  cachy_state="$(systemctl --user is-active cachy-update.service 2>/dev/null || echo inactive)"
  if [ "$cachy_state" = "active" ]; then
    echo "  cachy-update:       ✗ Running (may contend for the pacman DB lock)"
  else
    echo "  cachy-update:       ✓ Inactive / clean"
  fi

  local appimage_count
  appimage_count="$(count_entries "$CALIX_CONFIG/appimage-metadata-v2.db")"
  echo "  AppImages Indexed:  ✓ $appimage_count in ~/.config/calix/appimage-metadata-v2.db"

  # The probe's own record -- when it last ran, and what it found -- is the
  # daemon's document, printed by `calix releases`. Health says whether the
  # clock that starts it is armed, and nothing about state it cannot see.
  local timer_enabled timer_active
  timer_enabled="$(systemctl --user is-enabled calix-releases.timer 2>/dev/null || echo disabled)"
  timer_active="$(systemctl --user is-active calix-releases.timer 2>/dev/null || echo inactive)"
  if [ "$timer_enabled" = "enabled" ] && [ "$timer_active" = "active" ]; then
    echo "  calix-releases.timer: ✓ Enabled and active"
  else
    echo "  calix-releases.timer: · $timer_enabled / $timer_active"
  fi
  echo ""
}

cmd_gui() {
  # Locate the Calix GPUI binary. The cargo target directory can be
  # redirected by ~/.cargo/config.toml, so ask cargo rather than guessing.
  local cargo_target=""
  local manifest="$CALIX_HOME/Calix.Ui.Gpui/Cargo.toml"
  if command -v cargo >/dev/null 2>&1 && [ -f "$manifest" ]; then
    cargo_target="$(cargo metadata --format-version 1 --no-deps \
      --manifest-path "$manifest" 2>/dev/null \
      | "$PYTHON_BIN" -c 'import json,sys; print(json.load(sys.stdin)["target_directory"])' \
      2>/dev/null)"
  fi

  local candidates=(
    "$CALIX_HOME/Calix.Ui.Gpui/target/release/calix-gpui"
    "${cargo_target:+$cargo_target/release/calix-gpui}"
    "/usr/lib/calix/calix-gpui"
    "/usr/bin/calix-gpui"
  )
  for candidate in "${candidates[@]}"; do
    if [ -x "$candidate" ]; then
      exec "$candidate" "$@"
    fi
  done

  echo "No compiled Calix UI found. Build it with:" >&2
  echo "  (cd $CALIX_HOME/Calix.Ui.Gpui && cargo build --release)" >&2
  echo "Falling back to the system Calix (not the same product)." >&2
  exec /usr/bin/calix "$@"
}

case "${1:-help}" in
  sync|list)
    # Both wrote or printed the five state documents of the Python mirror.
    # The mirror is gone, and each of them has a successor that keeps one
    # writer: say which, rather than falling through to "unknown command".
    echo "calix $1 was removed with the Python state mirror it fed:" >&2
    echo "  calix releases [--refresh]  — what is tracked, and what the daemon saw" >&2
    echo "  calix inventory             — every installed package, one document" >&2
    exit 1
    ;;
  check)
    # Without its write, `check` was a second reader of the probe `releases`
    # performs, over a document it no longer owns.
    echo "calix check is gone: \`calix releases\` reports what is tracked and what" >&2
    echo "the daemon last saw, and \`calix releases --refresh\` asks it to probe." >&2
    exit 1
    ;;
  probe)
    shift
    exec "$PYTHON_BIN" "$RELEASE" probe "$@"
    ;;
  update|upgrade)
    shift
    exec "$PYTHON_BIN" "$RELEASE" update "$@"
    ;;
  registry)
    shift
    exec "$PYTHON_BIN" "$RELEASE" registry "$@"
    ;;
  verify)
    shift
    exec "$PYTHON_BIN" "$RELEASE" verify "$@"
    ;;
  health)
    cmd_health
    ;;
  inventory)
    shift
    for bin in "$CALIX_HOME/Calix.Cli.Zig/zig-out/bin/calix" "/usr/lib/calix/calix"; do
      if [ -x "$bin" ]; then
        exec "$bin" inventory "$@"
      fi
    done
    echo "No compiled Calix native engine found." >&2
    exit 1
    ;;
  gui)
    shift
    cmd_gui "$@"
    ;;
  -h|--help|help)
    show_help
    ;;
  *)
    for bin in "$CALIX_HOME/Calix.Cli.Zig/zig-out/bin/calix" "/usr/lib/calix/calix"; do
      if [ -x "$bin" ]; then
        exec "$bin" "$@"
      fi
    done
    echo "Unknown command '$1'. Run 'calix --help' for usage." >&2
    exit 1
    ;;
esac
