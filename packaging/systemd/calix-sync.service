[Unit]
Description=Calix Universal Package State Synchronizer
Documentation=file:///home/tension_atoi/Projects/calix/README.md
After=default.target

[Service]
Type=oneshot
# --runtime records the run in the engine's state directory. The repository's
# evidence/ tree is a development contract; a timer must not append to it.
ExecStart=%h/.local/bin/calix sync --quiet --runtime
StandardOutput=journal
StandardError=journal
Nice=10

[Install]
WantedBy=default.target
